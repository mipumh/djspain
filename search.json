---
layout: null
---
[
  {% for journo in site.data.journos %}
    {
      "nombre" : {{ journo.nombre | jsonify }},
      "alias" : {{ journo.alias | jsonify }},
      "modal_id" : {{ journo.alias | default: journo.modal | default: journo.nombre | slugify | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
