---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <description>{{ site.description | xml_escape }}</description>
    <link>{{ site.url }}/</link>
    <atom:link href="{{ '/feed.xml' | prepend: site.url }}" rel="self" type="application/rss+xml"/>
    <language>es</language>
    <pubDate>{{ site.time | date_to_rfc822 }}</pubDate>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    {% assign entrevistas = site.entrevistas | sort: 'date' | reverse %}
    {% for item in entrevistas limit: 20 %}
      <item>
        <title>{{ item.interviewee | xml_escape }} · {{ item.outlet | xml_escape }} — {{ item.title | strip_html | xml_escape }}</title>
        <description>{{ item.excerpt | strip_html | normalize_whitespace | truncate: 400 | xml_escape }}</description>
        <pubDate>{{ item.date | date_to_rfc822 }}</pubDate>
        <link>{{ item.url | prepend: site.url }}</link>
        <guid isPermaLink="true">{{ item.url | prepend: site.url }}</guid>
        {% if item.featured_image %}
        <media:thumbnail url="{{ site.url }}{{ item.featured_image }}"/>
        {% endif %}
        <category>Periodismo de datos</category>
        {% if item.outlet %}<category>{{ item.outlet | xml_escape }}</category>{% endif %}
      </item>
    {% endfor %}
  </channel>
</rss>
